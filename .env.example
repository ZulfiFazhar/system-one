# Application Settings
APP_NAME="System One (Laya) API"
ENVIRONMENT=development
VERSION=0.1.0

# Security & CORS
ALLOWED_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
LAYA_API_KEY=""

# Laya Model Settings
LAYA_MODEL_ID="convaiinnovations/laya-multilingual"
LAYA_MODEL_PATH="models/laya-multilingual"
LAYA_DEVICE="auto"
LAYA_PRELOAD=true
LAYA_LAZY_LOAD=false # Set true in development to load model on first request instead of startup

# Logging
LOG_LEVEL="INFO"
